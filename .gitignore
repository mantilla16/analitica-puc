# Entornos y dependencias -- se regeneran, no van en git
.venv/
__pycache__/
*.pyc
frontend/node_modules/
frontend/dist/

# Datos de clientes de auditoría -- NUNCA va al repo
archivos/

# Dumps y paquetes de traslado: traen los datos reales del cliente, no
# solo estructura. Suelen quedar dentro de db/ al mover cosas entre
# servidores. (db/schema.sql sí va: estructura + catálogo, sin datos.)
*.dump
*.sql.gz
*.backup
*.tar.gz
*.tgz

# Respaldos manuales locales -- git es el respaldo real ahora
BK/
filesV3/
filesV3.zip
frontend/files.zip

# Credenciales / configuración local
.env
.env.*
!.env.example

# Credencial viva: el refresh token con el que el servidor manda los
# códigos de acceso. Quien lo tenga puede enviar correo como la persona
# que autorizó, así que no va al repositorio ni siquiera siendo privado.
correo_token.json
correo_token.json.nuevo

# Insumos reales traídos a mano para probar un ERP nuevo. Son estados
# financieros de clientes: no van al repositorio ni siquiera siendo privado.
/Analisis */
/output/
/tmp/
